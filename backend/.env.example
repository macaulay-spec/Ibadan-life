# Copy to .env and fill in. Never commit real secrets.

# Server
PORT=3000
NODE_ENV=development

# Auth (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database. Dev/test uses Node's built-in SQLite (no server needed).
# Production swaps the driver to PostgreSQL — see src/db/database.ts
DB_DRIVER=sqlite
DB_PATH=./data/ibadan-life.db
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/ibadan_life

# Admin/system token for faucet & sink endpoints (wages, relief, rent, utilities).
# In production, replace with a proper service-to-service auth.
ADMIN_TOKEN=change-me-admin-token
